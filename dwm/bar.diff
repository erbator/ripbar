+/* Status text may contain the bytes \x01..\x0f, each switching to the
+ * colour scheme SchemeStatus + n - 1. Returns the width of the status. */
+int
+drawstatus(Monitor *m)
+{
+	char text[sizeof(stext)], *seg, *p;
+	int x, w = 2; /* 2px right padding */
+	unsigned int scm = SchemeStatus, len = strlen(stext);
+
+	strncpy(text, stext, sizeof(text));
+	for (p = text; *p; p++)
+		if ((unsigned char)*p < 0x10)
+			*p = '\0';
+	for (seg = text; seg < text + len; seg += strlen(seg) + 1)
+		if (*seg)
+			w += drw_fontset_getwidth(drw, seg);
+
+	x = m->ww - w;
+	for (p = seg = stext; ; p++) {
+		if (*p && (unsigned char)*p >= 0x10)
+			continue;
+		if (p > seg) {
+			strncpy(text, seg, p - seg);
+			text[p - seg] = '\0';
+			drw_setscheme(drw, scheme[scm]);
+			x = drw_text(drw, x, 0, drw_fontset_getwidth(drw, text), bh, 0, text, 0);
+		}
+		if (!*p)
+			break;
+		if (SchemeStatus + (unsigned char)*p - 1 < LENGTH(colors))
+			scm = SchemeStatus + (unsigned char)*p - 1;
+		seg = p + 1;
+	}
+	return w;
+}
